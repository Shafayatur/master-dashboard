    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.30",
