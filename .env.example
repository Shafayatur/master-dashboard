# Copy to .env.local and fill in. NEVER commit real values.

# Source (production) database - use the READ-ONLY role
SOURCE_DATABASE_URL=postgres://dashboard_ro:CHANGE_ME@host:5432/dbname
SOURCE_DB_SSL=require
# The source server uses a self-signed certificate; set to true only if you install its CA
SOURCE_DB_SSL_REJECT_UNAUTHORIZED=false
SOURCE_DB_POOL_MAX=3

# Neon project "master-dashboard" (use the POOLED connection string)
CONFIG_DATABASE_URL=postgres://user:CHANGE_ME@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Random string, 16+ chars. Send as header x-health-token to /api/health
HEALTH_TOKEN=
